# Public site for ${DOMAIN}.
#
# Only the variables listed in NGINX_ENVSUBST_FILTER (docker-compose.yml) are
# substituted; every other $name below is an nginx runtime variable.

# --- Plain HTTP: ACME HTTP-01 challenges, everything else -> https ----------
server {
    listen 80 default_server;
    server_name _;

    location ^~ /.well-known/acme-challenge/ {
        root /var/www/acme;
        default_type text/plain;
        try_files $uri =404;
    }

    location / {
        return 301 https://${DOMAIN}$request_uri;
    }
}

# --- HTTPS ----------------------------------------------------------------------
# TCP: Xray REALITY (host port 443) forwards every non-REALITY TLS connection
#      here unchanged, prefixed with a PROXY protocol header (xver) carrying
#      the real client address. nginx does the actual TLS handshake with the
#      real Let's Encrypt certificate.
# UDP: host port 443 is published straight to this container for HTTP/3.
server {
    listen ${NGINX_TLS_PORT} ssl default_server proxy_protocol;
    listen 443 quic reuseport default_server;
    server_name ${DOMAIN};

    http2 on;
    http3 on;

    ssl_certificate     /etc/nginx/certs/fullchain.pem;
    ssl_certificate_key /etc/nginx/certs/privkey.pem;

    # Trust PROXY protocol only from the internal docker network (Xray).
    # QUIC connections carry no PROXY header and keep their own address.
    set_real_ip_from ${DOCKER_SUBNET};
    real_ip_header proxy_protocol;

    # Never emit absolute redirects: the internal port (${NGINX_TLS_PORT}) must not
    # leak into Location headers of nginx's own redirects.
    absolute_redirect off;
    port_in_redirect off;

    # Short, per-deploy values close to the nginx defaults (60s / 75s). The long
    # timeouts needed by XHTTP live only in its location below.
    client_header_timeout ${NGINX_CLIENT_HEADER_TIMEOUT}s;
    keepalive_timeout ${NGINX_KEEPALIVE_TIMEOUT}s;

    add_header Alt-Svc 'h3=":443"; ma=${NGINX_ALTSVC_MAX_AGE}' always;
    add_header Strict-Transport-Security "max-age=${NGINX_HSTS_MAX_AGE}" always;

    set $xhttp_upstream xui:${XHTTP_PORT};
    set $panel_upstream xui:${PANEL_PORT};
    set $sub_upstream   xui:${SUB_PORT};
    set $app_upstream   fakeapp:8080;

    # VLESS + XHTTP. Xray's XHTTP inbound speaks h2c, so grpc_pass is used:
    # it streams request bodies (needed for stream-one / stream-up modes)
    # instead of buffering them like proxy_pass would.
    location /${XHTTP_PATH}/ {
        include /etc/nginx/conf.d/xhttp-proxy.inc;
        grpc_pass grpc://$xhttp_upstream;
    }

    # Additional XHTTP inbounds created in the panel: path
    # /${XHTTP_PATH}-<port>/ goes to xui:<port> for every port matching
    # XHTTP_ROUTE_PORT_RE (checked by docker-entrypoint.d/15-xhttp-route.envsh:
    # never the panel, subscription or nginx ports). New inbounds need no
    # nginx change.
    location ~ "^/${XHTTP_PATH_RE}-(?<xhttp_route_port>${XHTTP_ROUTE_PORT_RE})/" {
        include /etc/nginx/conf.d/xhttp-proxy.inc;
        grpc_pass grpc://xui:$xhttp_route_port;
    }

    # 3X-UI panel (webBasePath = /${PANEL_PATH}/).
    location = /${PANEL_PATH} {
        return 301 /${PANEL_PATH}/;
    }

    location /${PANEL_PATH}/ {
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto https;
        proxy_set_header Upgrade $http_upgrade;
        proxy_set_header Connection $connection_upgrade;
        # WebSocket (panel live updates) needs a long read timeout.
        proxy_read_timeout 300s;
        proxy_pass http://$panel_upstream;
    }

    # 3X-UI subscription server (subPath = /${SUB_PATH}/, so the URI is passed
    # through unchanged). The subscription ids in the URLs are secrets: no access log.
    location /${SUB_PATH}/ {
        access_log off;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto https;
        proxy_set_header Connection "";
        proxy_connect_timeout 10s;
        proxy_read_timeout 60s;
        proxy_send_timeout 60s;
        proxy_pass http://$sub_upstream;
    }

    # Decoy web application.
    location / {
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto https;
        proxy_set_header Connection "";
        proxy_pass http://$app_upstream;
    }
}

# Shared settings of the XHTTP locations (included from 10-site.conf).
# Rendered to conf.d/xhttp-proxy.inc: not *.conf, so it is not loaded at the
# http level by itself. Xray's XHTTP inbound speaks h2c, so grpc_pass is used:
# it streams request bodies (needed for stream-one / stream-up modes) instead
# of buffering them like proxy_pass would.
access_log off;
client_max_body_size 0;
# Long-lived XHTTP streams (values from XTLS/Xray-examples VLESS-XHTTP3-Nginx).
keepalive_timeout 5m;
client_body_timeout 5m;
grpc_read_timeout 315s;
grpc_send_timeout 5m;
grpc_set_header Host $host;
grpc_set_header X-Real-IP $remote_addr;
grpc_set_header X-Forwarded-For $proxy_add_x_forwarded_for;

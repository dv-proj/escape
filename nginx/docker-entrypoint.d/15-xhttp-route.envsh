#!/bin/sh
# Sourced by the nginx image entrypoint (*.envsh) before the templates are
# rendered (20-envsubst-on-templates.sh). Checks XHTTP_ROUTE_PORT_RE (ports of
# the additional XHTTP inbounds, used verbatim in the
# "/<XHTTP_PATH>-<port>/" location) and exports XHTTP_PATH_RE (XHTTP_PATH
# with regex metacharacters escaped). A bad value stops the container.

xhttp_route_fail() {
    echo "15-xhttp-route: $*" >&2
    exit 1
}

# (No ${VAR:=default} here: the "}" of "{4}" would end the expansion.)
[ -n "${XHTTP_ROUTE_PORT_RE:-}" ] || XHTTP_ROUTE_PORT_RE='1[0-9]{4}'
export XHTTP_ROUTE_PORT_RE

# Only digits, classes, counts and alternation: no anchors, dots or escapes.
if printf '%s' "$XHTTP_ROUTE_PORT_RE" | grep -q '[^][0-9{},|()?-]'; then
    xhttp_route_fail "XHTTP_ROUTE_PORT_RE may contain only 0-9 [ ] - { } , | ( ) ?"
fi
xhttp_route_ports="$(seq 0 99999 | grep -Ex "$XHTTP_ROUTE_PORT_RE")" ||
    xhttp_route_fail "XHTTP_ROUTE_PORT_RE '$XHTTP_ROUTE_PORT_RE' matches no port"
for p in $(printf '%s\n' "$xhttp_route_ports" | sed -n '1p;$p'); do
    if [ "$p" -lt 1024 ] || [ "$p" -gt 65535 ]; then
        xhttp_route_fail "XHTTP_ROUTE_PORT_RE matches $p: only ports 1024-65535 are allowed"
    fi
done
# The routed ports must never reach the panel, the subscription server or nginx.
for p in "${PANEL_PORT:-2053}" "${SUB_PORT:-2096}" "${NGINX_TLS_PORT:-8443}"; do
    if printf '%s\n' "$p" | grep -Eqx "$XHTTP_ROUTE_PORT_RE"; then
        xhttp_route_fail "XHTTP_ROUTE_PORT_RE matches port $p (panel/subscriptions/nginx)"
    fi
done

XHTTP_PATH_RE="$(printf '%s' "${XHTTP_PATH:?XHTTP_PATH is required}" | sed 's/[.]/\\./g')"
export XHTTP_PATH_RE

unset -f xhttp_route_fail
unset p xhttp_route_ports

# Generated by install.sh from nginx/default.conf.template: do not edit.
# Placeholders @NAME@ are filled in from .env; the certificate is the Let's
# Encrypt one when it exists, else a temporary self-signed one.
#
# Port 443 here is the container port of the HTTPS server; it is not published.
# The host HTTPS port (NGINX_HTTPS_PORT) goes to the TLS front (front.stream,
# stream.conf.template), which passes the connections on with the PROXY protocol.

# The real client address comes with the PROXY protocol header of the front
# (127.0.0.1); extensions may trust more senders (set_real_ip_from at http
# level in servers.d). Connections without the header (port 80) are not touched.
set_real_ip_from 127.0.0.1;
real_ip_header proxy_protocol;

# Plain HTTP: ACME http-01 challenges, everything else goes to HTTPS.
server {
    listen 80 default_server;
    server_name @DOMAIN@;
    server_tokens off;
    access_log off;

    location ^~ /.well-known/acme-challenge/ {
        root /var/www/acme;
        default_type text/plain;
    }

    location / {
        return 301 https://@DOMAIN@@HTTPS_PORT_SUFFIX@$request_uri;
    }
}

server {
    # Only from the TLS front (or another sender of the PROXY protocol).
    listen 443 ssl proxy_protocol default_server;
    http2 on;
    server_name @DOMAIN@;
    server_tokens off;
    access_log off;

    ssl_certificate     @SSL_CERT@;
    ssl_certificate_key @SSL_KEY@;
    ssl_protocols TLSv1.2 TLSv1.3;
    ssl_ciphers ECDHE-ECDSA-AES128-GCM-SHA256:ECDHE-RSA-AES128-GCM-SHA256:ECDHE-ECDSA-AES256-GCM-SHA384:ECDHE-RSA-AES256-GCM-SHA384:ECDHE-ECDSA-CHACHA20-POLY1305:ECDHE-RSA-CHACHA20-POLY1305;
    ssl_prefer_server_ciphers off;
    ssl_session_cache shared:SSL:5m;
    ssl_session_timeout 1d;
    ssl_session_tickets off;

    # Extensions: one .conf file each (a location block), see extensions.d/README.md.
    include /etc/nginx/locations.d/*.conf;

    # Everything else: the decoy app. The name is resolved at request time
    # (Docker DNS), so nginx starts even when the app is not up yet.
    location / {
        resolver 127.0.0.11 valid=10s ipv6=off;
        set $fakeapp_upstream http://fakeapp:@FAKEAPP_PORT@;
        proxy_pass $fakeapp_upstream;
        proxy_http_version 1.1;
        proxy_set_header Connection "";
        proxy_set_header Host $host;
        # The app rate-limits by X-Real-IP: always overwrite it.
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $remote_addr;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_connect_timeout 5s;
        proxy_read_timeout 60s;
    }
}

# Extensions with their own names: one .conf file each (whole server blocks,
# rendered from data/nginx/servers.d/<id>.conf.in), see extensions.d/README.md.
include /etc/nginx/servers.d/*.conf;

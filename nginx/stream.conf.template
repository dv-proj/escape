# Generated by install.sh from nginx/stream.conf.template: do not edit.
#
# The TLS front on the published HTTPS port (host NGINX_HTTPS_PORT -> container
# port @FRONT_PORT@). The TLS handshake is not terminated here: ssl_preread reads
# the server name (SNI) of the ClientHello and the connection is passed on as is.
#   - SNI routes of extensions (data/nginx/stream.d/<id>.map, "NAME HOST:PORT;",
#     written by ext_nginx_stream_put) go to that target;
#   - everything else (DOMAIN, the names of extensions in servers.d, no SNI)
#     goes to the HTTPS server of this nginx (container port 443, not published).
# Every connection is passed with the PROXY protocol (v1): the receiver learns
# the real client address ($remote_addr / X-Real-IP / X-Forwarded-For of the
# HTTPS server; an extension target must accept the PROXY protocol too).

map $ssl_preread_server_name $escape_front_upstream {
    hostnames;
    default escape_https;
    include /etc/nginx/stream.d/*.map;
}

upstream escape_https {
    server 127.0.0.1:443;
}

server {
    listen @FRONT_PORT@;
    ssl_preread on;
    preread_timeout 10s;
    # Targets of the routes are compose services: resolved per connection
    # (Docker DNS), so nginx starts and reloads while one of them is down.
    resolver 127.0.0.11 valid=10s ipv6=off;
    proxy_pass $escape_front_upstream;
    proxy_protocol on;
    proxy_connect_timeout 5s;
    # Idle time between two reads or writes (long-lived tunnels, WebSocket).
    proxy_timeout 1h;
}

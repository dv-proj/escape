# =============================================================================
# Personal VPN stack configuration.
#
# Copy to `.env` (the deploy script does this for you) and fill in the values
# marked [manual]. Values marked [generated] are created by the deploy script
# (`scripts/xui.sh genkeys` and random generators) and normally should not be
# edited by hand. Values marked [default] can be left as they are.
#
# Format: plain KEY=value, one per line, no `export`. Quotes are optional;
# values may contain spaces (docker compose .env syntax).
# =============================================================================

# --- Domain & TLS -------------------------------------------------------------
# [manual] Public domain name whose A/AAAA record points to this server. Pick
# a neutral name (e.g. app.example.com): it is visible in SNI and CT logs, so
# avoid words like vpn, proxy, xray, tunnel.
DOMAIN=app.example.com
# [manual] E-mail for the Let's Encrypt account (expiry notices).
ACME_EMAIL=admin@example.com
# [default] ACME CA for acme.sh: `letsencrypt` (production) or
# `letsencrypt_test` (staging, untrusted certs, for dry runs).
ACME_SERVER=letsencrypt

# --- Camouflage web application (fake-webapp) ---------------------------------
# [generated] Name of the decoy site shown to visitors and active probes. If
# left empty at deploy, a random believable name is generated (interactive
# deploy offers it as the default). Never reuse the sample values of others.
APP_NAME=
# [generated] Meta description of the decoy site (same rules as APP_NAME).
APP_DESCRIPTION=
# [generated] Meta keywords of the decoy site (same rules as APP_NAME).
APP_KEYWORDS=
# [generated] Random lowercase hex string, 8-12 chars. The decoy app serves
# random data at /random-<suffix>?size=N (other paths redirect to /).
RANDOM_DATA_SUFFIX=
# [generated] 32 lowercase hex chars. Seed of the decoy login page: the markup,
# CSS and texts are generated from it once and saved to
# $DATA_DIR/fakeapp/page.html, which you may edit by hand (then restart
# fakeapp). Delete the file to regenerate it; change the seed and delete the
# file for a different variant.
PAGE_SEED=
# [generated] Per-client-IP rate limit of the decoy app, requests/second:
# random integer 8-15.
RATE_LIMIT_RPS=
# [generated] Per-client-IP burst size: random integer 15-40.
RATE_LIMIT_BURST=
# [generated] Global ceiling for all clients together, requests/second:
# random integer 150-400.
RATE_LIMIT_GLOBAL_RPS=
# [generated] Minimum delay of POST /login in milliseconds: random 180-400.
LOGIN_DELAY_MIN_MS=
# [generated] Maximum delay of POST /login in milliseconds: minimum + 300-900.
LOGIN_DELAY_MAX_MS=
# [generated] Time zone for containers (and the decoy app's timestamps). Taken
# from the host at deploy (UTC if unknown); change by hand if needed.
TZ=

# --- nginx hardening (generated per deploy) --------------------------------------
# [generated] nginx client_header_timeout in seconds: random integer 20-60.
NGINX_CLIENT_HEADER_TIMEOUT=
# [generated] nginx keepalive_timeout in seconds: random integer 45-90.
NGINX_KEEPALIVE_TIMEOUT=
# [generated] Strict-Transport-Security max-age in seconds: one of 15552000,
# 31536000, 63072000.
NGINX_HSTS_MAX_AGE=
# [generated] Alt-Svc "ma" in seconds: one of 3600, 86400, 604800, 2592000.
NGINX_ALTSVC_MAX_AGE=

# --- 3X-UI panel ------------------------------------------------------------------
# The panel is NOT published; it is reachable only via nginx at
# https://DOMAIN/PANEL_PATH/
# [generated] Secret URL path segment for the panel (no slashes).
PANEL_PATH=change-me-panel-path
# [manual] Panel admin username (asked at deploy, default admin).
PANEL_USERNAME=admin
# [generated] Panel admin password.
PANEL_PASSWORD=change-me-strong-password
# [default] Panel port inside the docker network.
PANEL_PORT=2053

# --- Xray inbounds ----------------------------------------------------------------
# [generated] Secret URL path segment for the XHTTP inbound (no slashes).
XHTTP_PATH=change-me-xhttp-path
# [default] XHTTP inbound port inside the docker network (not published).
XHTTP_PORT=10000
# [default] nginx TLS port inside the docker network: REALITY "target" (with
# PROXY protocol). Not published.
NGINX_TLS_PORT=8443
# [generated] REALITY x25519 private key (`scripts/xui.sh genkeys`).
REALITY_PRIVATE_KEY=
# [generated] REALITY x25519 public key (pair of REALITY_PRIVATE_KEY).
REALITY_PUBLIC_KEY=
# [generated] REALITY short id: 8-16 hex characters.
REALITY_SHORT_ID=
# [generated] REALITY maxTimeDiff in milliseconds: random integer 60000-120000.
# Client clocks must be within this window of the server clock; 0 disables
# the check (replayed ClientHellos are then accepted). Used by
# `scripts/xui.sh provision` for NEW inbounds only; edit existing ones in the panel.
REALITY_MAX_TIME_DIFF_MS=
# [generated] VLESS client UUID (shared by both inbounds).
CLIENT_UUID=

# --- Storage & network --------------------------------------------------------------
# [default] Host directory for persistent data (panel DB, certs, acme.sh
# state, ACME webroot). Relative paths are relative to the repo root.
DATA_DIR=./data
# [default] Subnet of the internal docker bridge network. nginx trusts PROXY
# protocol headers only from this subnet. Change only if it collides.
DOCKER_SUBNET=172.30.53.0/24

# --- Image pins ------------------------------------------------------------------------
# [default] Pinned image versions. Bump deliberately.
XUI_IMAGE=ghcr.io/mhsanaei/3x-ui:v3.11.0
# [default] nginx image; must be built with --with-http_v3_module (HTTP/3).
NGINX_IMAGE=nginx:1.31.8-alpine
# [default] acme.sh image (certificate issuance and renewal).
ACME_IMAGE=neilpang/acme.sh:3.1.6

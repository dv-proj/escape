# =============================================================================
# fake-webapp (decoy web application) configuration.
#
# Copy to `.env` (`vpn.sh install` does this for you). Values marked
# [generated] are created by the install script and normally should not be
# edited by hand. Values marked [default] can be left as they are. Values
# marked [optional] may stay empty.
#
# Format: plain KEY=value, one per line, no `export`. Quotes are optional;
# values may contain spaces (docker compose .env syntax).
# =============================================================================

# --- Site identity ------------------------------------------------------------
# [generated] Name of the decoy site shown to visitors and active probes. If
# left empty at install, a random believable name is generated (interactive
# install offers it as the default). Never reuse the sample values of others.
APP_NAME=
# [generated] Meta description of the decoy site (same rules as APP_NAME).
APP_DESCRIPTION=
# [generated] Meta keywords of the decoy site (same rules as APP_NAME).
APP_KEYWORDS=
# [optional] DNS name (or IP address) of the site, e.g. app.example.com,
# without a scheme; not checked. The app gets https://<DOMAIN> for the
# canonical link and og:url. Empty: these tags are not emitted. A DNS name
# also gets a Let's Encrypt certificate (it must resolve to this host and
# port 80 must be reachable); without it, or for an IP address, nginx serves
# a self-signed certificate.
DOMAIN=

# --- TLS (nginx + certbot) ------------------------------------------------------
# [optional] Contact e-mail for the Let's Encrypt account (asked at install
# when DOMAIN is a DNS name). Empty: the account is registered without one.
ACME_EMAIL=
# [default] 1: use the Let's Encrypt staging server (test certificates, not
# trusted by browsers, much higher rate limits). Switching back to 0 replaces
# the test certificate with a production one at the next start.
ACME_STAGING=0
# [default] 1: TLS 1.3 key exchange may use the post-quantum hybrid group
# X25519MLKEM768 (OpenSSL default; protects recorded traffic against future
# quantum attacks). 0: classic groups only (X25519, P-256, P-384). Applies to
# every name on port 443 (nginx cannot set it per name). Set 0 if Telegram
# WEB-proxy clients on Android fail to connect (telegramdesktop/tproxy-server#16).
TLS_PQ=1
# [default] Name of the shared Docker volume with the certificates
# (/etc/letsencrypt layout: live/<DOMAIN>/fullchain.pem, privkey.pem). Other
# containers mount it to reuse the certificates.
# TLS_CERTS_VOLUME=tls-certs

# --- Behaviour ------------------------------------------------------------------
# [generated] Random lowercase hex string, 8-12 chars. The decoy app serves
# random data at /random-<suffix>?size=N (other paths redirect to /).
RANDOM_DATA_SUFFIX=
# [generated] 32 lowercase hex chars. Seed of the decoy site: `vpn.sh install`
# generates login.html (markup, CSS, texts) and favicon.ico (with the first
# letter of APP_NAME) from it into the data directory when they are missing;
# edit them by hand if you like. For a different variant change the seed,
# delete both files and re-run install. The app also derives its security
# headers and error page texts from the seed at every start.
PAGE_SEED=
# [generated] Per-client-IP rate limit, requests/second: random integer 8-15.
RATE_LIMIT_RPS=
# [generated] Per-client-IP burst size: random integer 15-40.
RATE_LIMIT_BURST=
# [generated] Global ceiling for all clients together, requests/second:
# random integer 150-400.
RATE_LIMIT_GLOBAL_RPS=
# [generated] Minimum delay of POST /login in milliseconds: random 180-400.
LOGIN_DELAY_MIN_MS=
# [generated] Maximum delay of POST /login in milliseconds: minimum + 300-900.
LOGIN_DELAY_MAX_MS=
# [generated] Time zone of the container (and the page's timestamps). Taken
# from the host at install (UTC if unknown); change by hand if needed.
TZ=

# --- Network & storage ------------------------------------------------------------
# [default] Host address the app port is published on. 127.0.0.1 keeps it
# local (a TLS proxy in front is expected; the app trusts X-Real-IP). Use
# 0.0.0.0 to expose it directly.
FAKEAPP_BIND=127.0.0.1
# [default] Port of the app: it listens on it inside the container, it is
# published on FAKEAPP_BIND:FAKEAPP_PORT of the host and nginx proxies to
# fakeapp:FAKEAPP_PORT. Not 80 or 443 (taken by nginx on the host). Ports
# below 1024 make `vpn.sh install` lower net.ipv4.ip_unprivileged_port_start.
FAKEAPP_PORT=8080
# [default] Data directory (login.html, favicon.ico and any other files the
# site serves) is ./data/fakeapp, mounted read-only. To move it, set
# FAKEAPP_DATA_DIR to an absolute path (or a path relative to fake-webapp/)
# and re-run `vpn.sh install`.
# FAKEAPP_DATA_DIR=

# --- Telegram WEB-proxy (Telemt, WEB transport) ------------------------------------
# [optional] Subdomain label of the Telegram WEB-proxy, e.g. static: the proxy
# answers on <label>.<DOMAIN> (a single DNS label, a-z 0-9 -; not checked in
# DNS: create the A record yourself). Needs DOMAIN to be a DNS name. Empty:
# the feature is off (asked at install). Manage users with
# `vpn.sh webproxy user add|del|list|link`; the first run creates user1.
WEBPROXY_SUBDOMAIN=
# [optional] Public IPv4 of this host that clients reach on port 443 (Telemt
# needs a concrete address). Asked at install when the proxy is on; the
# suggestion is the address of <label>.<DOMAIN>, else of the default route.
WEBPROXY_PUBLIC_IP=
# [generated] Docker compose profiles to start. Managed by vpn.sh: "webproxy"
# when WEBPROXY_SUBDOMAIN is set (compose then starts the webproxy service),
# empty otherwise. Do not edit by hand; change WEBPROXY_SUBDOMAIN and re-run
# `vpn.sh install` instead.
COMPOSE_PROFILES=
# [default] How `vpn.sh webproxy user add|del` applies the change to a running
# proxy. hot: Telemt re-reads its config by itself; new users work at once,
# sessions of a deleted user are closed, other clients stay connected (falls
# back to recreate if no reload shows up in the log within 15s). recreate:
# the container is recreated and every client reconnects.
WEBPROXY_RELOAD=hot
# [default] Docker network of the proxy, and the addresses of nginx and Telemt
# in it.
# WEBPROXY_SUBNET=172.30.53.0/24
# WEBPROXY_NGINX_IP=172.30.53.2
# WEBPROXY_TELEMT_IP=172.30.53.3
# [default] Data directory (users file, telemt/config.toml; mode 0700) is
# ./data/webproxy. To move it, set an absolute path (or one relative to
# webproxy/) and re-run `vpn.sh install`.
# WEBPROXY_DATA_DIR=

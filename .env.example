# =============================================================================
# Personal VPN stack configuration.
#
# Copy to `.env` (the deploy script does this for you) and fill in the values
# marked [manual]. Values marked [generated] are created by the deploy script
# (`scripts/xui.sh genkeys` and random generators) and normally should not be
# edited by hand. Values marked [default] can be left as they are.
#
# Format: plain KEY=value, one per line, no `export`. Quotes are optional;
# values may contain spaces (docker compose .env syntax).
# =============================================================================

# --- Domain & TLS -------------------------------------------------------------
# [manual] Public domain name whose A/AAAA record points to this server.
DOMAIN=vpn.example.com
# [manual] E-mail for the Let's Encrypt account (expiry notices).
ACME_EMAIL=admin@example.com
# [default] ACME CA for acme.sh: `letsencrypt` (production) or
# `letsencrypt_test` (staging, untrusted certs, for dry runs).
ACME_SERVER=letsencrypt

# --- Camouflage web application (fake-webapp) ---------------------------------
# [manual] Name/description/keywords of the decoy site shown to visitors and
# active probes. Make them look like a boring, believable web service.
APP_NAME=Notely
APP_DESCRIPTION=Simple shared notes for small teams
APP_KEYWORDS=notes, collaboration, productivity
# [default] Time zone for containers (and the decoy app's timestamps).
TZ=Europe/Amsterdam

# --- 3X-UI panel ------------------------------------------------------------------
# The panel is NOT published; it is reachable only via nginx at
# https://DOMAIN/PANEL_PATH/
# [generated] Secret URL path segment for the panel (no slashes).
PANEL_PATH=change-me-panel-path
# [generated] Panel admin credentials (username may be set manually).
PANEL_USERNAME=admin
PANEL_PASSWORD=change-me-strong-password
# [default] Panel port inside the docker network.
PANEL_PORT=2053

# --- Xray inbounds ----------------------------------------------------------------
# [generated] Secret URL path segment for the XHTTP inbound (no slashes).
XHTTP_PATH=change-me-xhttp-path
# [default] XHTTP inbound port inside the docker network (not published).
XHTTP_PORT=10000
# [default] nginx TLS port inside the docker network: REALITY "target" (with
# PROXY protocol). Not published.
NGINX_TLS_PORT=8443
# [generated] REALITY x25519 key pair (`scripts/xui.sh genkeys`).
REALITY_PRIVATE_KEY=
REALITY_PUBLIC_KEY=
# [generated] REALITY short id: 8-16 hex characters.
REALITY_SHORT_ID=
# [generated] VLESS client UUID (shared by both inbounds).
CLIENT_UUID=

# --- Storage & network --------------------------------------------------------------
# [default] Host directory for persistent data (panel DB, certs, acme.sh
# state, ACME webroot). Relative paths are relative to the repo root.
DATA_DIR=./data
# [default] Subnet of the internal docker bridge network. nginx trusts PROXY
# protocol headers only from this subnet. Change only if it collides.
DOCKER_SUBNET=172.30.53.0/24

# --- Image pins ------------------------------------------------------------------------
# [default] Pinned image versions. Bump deliberately.
XUI_IMAGE=ghcr.io/mhsanaei/3x-ui:v3.11.0
# Official nginx image built with --with-http_v3_module (HTTP/3 / QUIC).
NGINX_IMAGE=nginx:1.31.8-alpine
ACME_IMAGE=neilpang/acme.sh:3.1.6

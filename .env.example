# =============================================================================
# fake-webapp (decoy web application) configuration.
#
# Copy to `.env` (`install.sh install` does this for you). Values marked
# [generated] are created by the install script and normally should not be
# edited by hand. Values marked [default] can be left as they are. Values
# marked [required] are asked at install. Values marked [optional] may stay
# empty.
#
# Format: plain KEY=value, one per line, no `export`. Quotes are optional;
# values may contain spaces (docker compose .env syntax).
# =============================================================================

# --- Interface ------------------------------------------------------------------
# [default] Language of the install script's messages: en or ru. Asked first at
# an interactive install (default: en); `--lang` and the FAKEAPP_LANG
# environment variable override it. Reused silently on later runs.
FAKEAPP_LANG=en

# --- Site identity ------------------------------------------------------------
# [generated] Name of the decoy site shown to visitors and active probes. If
# left empty at install, a random believable name is generated (interactive
# install offers it as the default). Never reuse the sample values of others.
APP_NAME=
# [generated] Meta description of the decoy site (same rules as APP_NAME).
APP_DESCRIPTION=
# [generated] Meta keywords of the decoy site (same rules as APP_NAME).
APP_KEYWORDS=
# [required] DNS name of the site, e.g. app.example.com, without a scheme. Its
# A/AAAA record must point to this server: nginx serves it (server_name) and
# Let's Encrypt issues the certificate for it. The app gets https://<DOMAIN>
# for the canonical link and og:url. Asked at install.
DOMAIN=

# --- Behaviour ------------------------------------------------------------------
# [generated] Random lowercase hex string, 8-12 chars. The decoy app serves
# random data at /random-<suffix>?size=N (other paths redirect to /).
RANDOM_DATA_SUFFIX=
# [generated] 32 lowercase hex chars. Seed of the decoy site: `install.sh install`
# generates login.html (markup, CSS, texts) and favicon.ico (with the first
# letter of APP_NAME) from it into the data directory when they are missing;
# edit them by hand if you like. For a different variant change the seed,
# delete both files and re-run install. The app also derives its security
# headers and error page texts from the seed at every start.
PAGE_SEED=
# [generated] Per-client-IP rate limit, requests/second: random integer 8-15.
RATE_LIMIT_RPS=
# [generated] Per-client-IP burst size: random integer 15-40.
RATE_LIMIT_BURST=
# [generated] Global ceiling for all clients together, requests/second:
# random integer 150-400.
RATE_LIMIT_GLOBAL_RPS=
# [generated] Minimum delay of POST /login in milliseconds: random 180-400.
LOGIN_DELAY_MIN_MS=
# [generated] Maximum delay of POST /login in milliseconds: minimum + 300-900.
LOGIN_DELAY_MAX_MS=
# [generated] Time zone of the container (and the page's timestamps). Taken
# from the host at install (UTC if unknown); change by hand if needed.
TZ=

# --- Network & storage ------------------------------------------------------------
# [default] Port of the app inside the compose network: it listens on it and
# nginx proxies to http://fakeapp:FAKEAPP_PORT. It is not published on the
# host, so it cannot collide with Xray / 3X-UI / other ports; change it only
# if you have a reason.
FAKEAPP_PORT=8080
# [default] Data directory (login.html, favicon.ico and any other files the
# site serves) is ./data/fakeapp, mounted read-only. To move it, set
# FAKEAPP_DATA_DIR to an absolute path (or a path relative to fake-webapp/)
# and re-run `install.sh install`.
# FAKEAPP_DATA_DIR=

# --- nginx & certificates ---------------------------------------------------------
# [default] Host port of the nginx container for plain HTTP (ACME challenges
# and the redirect to HTTPS). Let's Encrypt only validates on port 80, so
# change it only if you forward port 80 to it yourself.
NGINX_HTTP_PORT=80
# [default] Host port of the nginx container for HTTPS. Must be free: stop the
# host nginx / Xray (or move them) before install.
NGINX_HTTPS_PORT=443
# [default] Container log rotation (Docker json-file, same for every service):
# LOG_MAX_FILE files of up to LOG_MAX_SIZE each, the oldest is dropped. 5m x 3 =
# at most 15 MB per container, which with access logs off holds well over 3 days;
# Docker has no rotation by age, so the size is the only limit. Applied on the
# next `./install.sh restart` (containers are recreated).
LOG_MAX_SIZE=5m
LOG_MAX_FILE=3
# [optional] E-mail for Let's Encrypt (expiry notices). Empty: register
# without an e-mail. Asked at install.
LE_EMAIL=
# [default] 1: use the Let's Encrypt staging CA (untrusted certificates, no
# rate limits): for testing only. 0: the real CA. After switching from 1 to 0
# delete ./data/letsencrypt and re-run `install.sh install`.
LE_STAGING=0
